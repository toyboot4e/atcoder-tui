{
  "name": "atcoder-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "dev:node": "node --import tsx src/index.tsx",
    "build": "bun build --compile src/index.tsx --outfile dist/atcoder-tui",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt src scripts test/*.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "watch": "bun --watch run src/index.tsx"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
